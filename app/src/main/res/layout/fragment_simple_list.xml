<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout android:id="@+id/filterRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Spinner android:id="@+id/spFilter1" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" />
        <Spinner android:id="@+id/spFilter2" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" />
    </LinearLayout>
    <TextView android:id="@+id/tvEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:textColor="@color/text_secondary" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
</LinearLayout>
